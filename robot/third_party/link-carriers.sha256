#
# The one native file the APK gains: the jar's arm64-v8a/libtor.so (8,842,120 bytes, already stripped, a position-independent
# executable for /system/bin/linker64, "tor 0.4.9.14"). :link's torBinary task copies it out of the pinned jar at build time
# and refuses any other bytes; tools/verify_apk.sh checks the APK's copy. Never the jar's other three ABIs.
fee641c956e85c40552b6005a6f88deb157d84e217307214a846ba0640ec44c3  lib/arm64-v8a/libtor.so
#
# And lyrebird's executable, which isn't from Maven: tools/build_lyrebird.sh builds it from source (lyrebird 0.9.0, commit
# 89d54872b176, with third_party/patches/lyrebird-0.9.0-deps.patch; Go 1.27.3, NDK r27b; 17,694,016 bytes, stripped, a
# position-independent executable for /system/bin/linker64, 16 KB-aligned) and gets these same bytes on any machine.
# :link's lyrebirdBinary task reads it from third_party/lyrebird/; Tor starts it, only for a bridge line that names its
# transport. Never the other three ABIs.
de94bedd76f43dc495a1e53dd3fc7d886495ac43d48d7864aba08ae4ad416845  lib/arm64-v8a/liblyrebird.so
