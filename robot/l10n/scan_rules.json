  "json_call": "(^|\\.)(put|opt|optString|optInt|optLong|optBoolean|optDouble|optJSONObject|optJSONArray|get|getString|getInt|getLong|getBoolean|getDouble|getJSONObject|getJSONArray|has|isNull|remove|putExtra|getStringExtra|getIntExtra|getLongExtra|getBooleanExtra|getParcelableExtra|hasExtra|putString|putInt|putLong|putBoolean|getStringArrayList|putStringArrayList|getQueryParameter|appendQueryParameter|header|addHeader|setHeader|getHeader|str|long|int|bool|hasOpt|attr|getElementsByTag|getSystemService|getSharedPreferences|edit|getPersistableBundle|optStringOrNull|optArray|stringOrNull|getStringOrNull|optObj|optStr|field|key|withName|getColumnIndex|getColumnIndexOrThrow|query|setAction|setPackage|setClassName|ComponentName|Intent|Uri\\.parse|parse|File|resolve|openFileInput|openFileOutput|getDir|asset|open|createTempFile|Thread|HandlerThread|newWakeLock|NotificationChannel|createNotificationChannel|setChannelId|getIdentifier|createChannel|channel|ofPattern|forLanguageTag|Locale|loadLibrary|Class\\.forName|getMethod|getDeclaredField|getDeclaredMethod|forName|getProperty|testTag|tag|Tag)$",
  "regex_call": "(^|\\.)(Regex|toRegex|compile|Pattern\\.compile|matches|split|replace|containsMatchIn|find|findAll|rx|re)$",
  "input_call": "(^|\\.)(setOf|listOf|mutableSetOf|hashSetOf|arrayOf|mapOf|mutableListOf|words|phrases|list|en|fr|enFr|startsWith|endsWith|contains|removePrefix|removeSuffix|replace|indexOf|lastIndexOf|split|equals|substringAfter|substringBefore|substringAfterLast|substringBeforeLast|any|all|none|first|firstOrNull|trimEnd|trimStart|trim|drop|dropLast|take|startsWithAny|endsWithAny|has|hasWord|hasAny|word|phrase|w|p|at|seq|lead|lead2|opener|strip|after|cut|verb|verbs|alias|aliases|syn|cue|cues|fold|plain|symbol|asList|listOfNotNull|in|is|kw|keyword|keywords|stop|stops|match|m|x|tok|t)$",
  "ui_sink": "(^|\\.)(Text|Button|TextButton|OutlinedButton|FilledTonalButton|Tip|SetupLine|PreferenceItem|SwitchPreference|StatusPreference|ListPreference|TextPreference|PreferenceScreen|preferenceGroup|preferenceFooter|ConfirmDialog|EditDialog|AlertDialog|Toast\\.makeText|makeText|setContentTitle|setContentText|setTicker|setSubText|BigTextStyle|bigText|setBigContentTitle|setSummaryText|Action\\.Builder|addAction|Snackbar|showSnackbar|say|reply|speak|card|Card|Line|Executed|Refused|Done|notify|title|label|placeholder|supportingText|contentDescription|stringOf|RadioRow|SwitchRow|InfoRow|Row|Chip|AssistChip|FilterChip|SuggestionChip|Badge|Banner|Hint|Header|Section|Step|Bullet|Para|Body|Note|Warn|Empty|TopBar|TopAppBar|Scaffold|IconButton|Icon|Tab|Choice|Option|Item|Field|Message|show|toast|status|append|add|ask|offer|line|lines|setTitle|setMessage|setLabel|setShortLabel|setLongLabel|ShortcutInfo\\.Builder|setDescription|setName|ActionCard|ActionChip|DoneCard|ReplyCard)$",
  "prompt_rx": "\\b(the user'?s?|the person|You are|you are Robot|Reply with|Reply only|Answer (in|with|only)|never follow|instructions|tool results?|Do not add|Do not|Don't add|Keep (the|names|answers)|Translate the|call (web_search|weather|ask_claude|phone_status|send_text|browser_search|[a-z]+_[a-z_]+)|e\\.g\\.|Whole minutes|JSON|function call|information, not instructions|information, never|Write at most|bullet points)\\b",
  "router_file": "(Router|Words|Commands|Matcher|Parser|Lexer|Analyzer|Texting|CardAnswer|Phrases|WakePhrases|Quoted|When|Wer|Segmenter|SecretDetector|SecretMask|ReadOnlyCommands|ShellLexer|PageText|WebText|Passages|Bm25|Normal|Folding|SpokenChoice|HandsFreeRouter|ContactMatcher|People|Groups|QueryCheck|Nearby|Weather|Notes|Calendar|Speech|LangId|Translate|Brief|Summary|Maps)\\.kt$",
  "fr_accent": "[éèêàâçùûôîœëïÉÈÊÀÂÇÙÛÔÎŒ«»]",
  "fr_elision": "(?i)(?<![a-z])(l|d|qu|c|j|n|s|m|t|jusqu|lorsqu|puisqu)['’][a-zàâéèêîôûh]",
  "enum_call": "^[A-Z][A-Z0-9_]+$",
  "ident_shape": "^[A-Za-z_][A-Za-z0-9_.\\-:/]*$",
  "addr": "(://|^/|^[a-z0-9_]+(\\.[a-z0-9_]+){2,}$|^[a-z]+/[a-z0-9.+\\-*]+$|\\.(json|tsv|txt|bin|onnx|gguf|litertlm|task|zip|tar|gz|bz2|xz|png|jpg|wav|pcm|s16|so|apk|kt|md|html|xml|csv|vcf|ics|log|bad|tmp|lock|key|pem|model|spm|vocab|tokens|sh|py)$|^[a-z]+:$|^(mailto|tel|smsto|sms|geo|xmpp|om|content|file|package|intent|https?):)",
  "format": "^[%\\s\\d.,:;()\\-+#0dsfxXEHhmMyYaSkKz'/]*$|^(d|dd|EEE|EEEE|MMM|MMMM|yyyy|HH|hh|mm|ss|a)([\\s,./:\\-]+(d|dd|EEE|EEEE|MMM|MMMM|yyyy|HH|hh|mm|ss|a))*$",
  "regex_syntax": "(\\\\[sSdDwWbB]|\\(\\?[:=!<i]|\\[\\^|\\[[a-z]-[a-z]|\\$$|^\\^|\\\\\\.|\\|\\(|\\)\\?|\\+\\)|\\{\\d)",
  "word": "[^\\W\\d_]{2,}",
  "word3": "[^\\W\\d_]{3,}",
  "multi": "[^\\W\\d_]{2,}[\\s\\-—–,:/·]+\\W*[^\\W\\d_]{2,}",
  "svg_path": "^[MmLlHhVvCcSsQqTtAaZz0-9.,\\s\\-]{20,}$",
  "hex": "^[0-9a-fA-F]{16,}$",
  "latin3": "[A-Za-z]{3,}",
  "prompt_call": "Prompt\\}?$",
  "the_user": "\\b(the user|the user's|the person)\\b",
  "you": "\\b(you|your)\\b",
  "cap_word_end": "^[A-Z][a-zà-ÿ]+[.!?…]$",
  "cap_word": "^[A-Z][a-zà-ÿ]+$",
  "lower_word": "^[a-zà-ÿ]+$",
  "key_shape": "^[a-z]+([A-Z][a-z0-9]*)+$|^[a-z0-9]+(_[a-z0-9]+)+$|^[A-Z0-9]+(_[A-Z0-9]+)*$|.*[.:/].*",
  "starts_lower": "^\\W*[a-zà-ÿ]",
  "ends_sentence": "[.!?:…»”)]\\s*$",
  "starts_upper": "^[A-Z]",
  "en_contraction": "[a-z]'(s|t|m|re|ll|ve|d)\\b",
  "lang_word": "[a-zàâäéèêëîïôöùûüçœ']+",
  "logcode_enum": "enum class \\w+\\s*\\([^{]*?\\)\\s*:\\s*[^{]*\\bLogCode\\b[^{]*\\{",
  "whitespace": "\\s"
 },
