<!-- Today's home-screen widget (home-design H9): a title and one block of text, the day line, the lock screen summary (counts
     and times only) or a line (unlock, Robot is locked, turn Today on), filled by ui/today/TodayWidget.kt. A tap opens Robot.
     Framework views only: no library. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lists_widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">
    <TextView
        android:id="@+id/today_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/today_widget_label"
        android:textColor="@color/lists_widget_ink"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/today_widget_line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:gravity="top|start"
        android:paddingTop="4dp"
        android:textColor="@color/lists_widget_ink"
        android:textSize="15sp" />
</LinearLayout>
