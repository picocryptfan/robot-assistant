<!-- 1.4 Lists' home-screen widget (lists-plan.md §7.6, D12; LS6): the list's name (a tap opens its page), its open items
     with tick boxes (a RemoteCollectionItems list, filled by sys/ListsWidget.kt), and a line for how many are done; or,
     instead of the items, one line (unlock to see it, Robot is locked, pick a list). Framework views only: no library. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lists_widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/lists_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/lists_widget_label"
        android:textColor="@color/lists_widget_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lists_widget_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/lists_widget_line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:paddingTop="4dp"
        android:textColor="@color/lists_widget_ink"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lists_widget_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:gravity="center_vertical"
        android:textColor="@color/lists_widget_quiet"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
