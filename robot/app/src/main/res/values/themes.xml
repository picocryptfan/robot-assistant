<resources>
    <!-- Compose draws the UI; the window theme only sets the background before the first frame: the system's surface
         colour (wallpaper-tinted, API 34), so a cold start doesn't flash white. -->
    <style name="Theme.Robot" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/system_surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Robot.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
