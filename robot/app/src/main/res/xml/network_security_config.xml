<?xml version="1.0" encoding="utf-8"?>
<!-- 0.6.0, for a helper on your own network: Robot's own rule decides which http:// addresses a helper may use (core
     LanRule: loopback, private, link-local, Tailscale's 100.64/10 and IPv6 unique-local addresses only; enforced again on
     every connection by the helper's DNS filter and network interceptor, :helpers HelperHttp). This file only lets
     OkHttp try. Clients for a company refuse cleartext in code too. User-added CAs are never trusted: one could read a
     company's traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Never cleartext to a company, the model downloads or the services Robot asks by itself (the weather, the nearest
         place, GitHub for the updater), whatever the code does: before 0.6.0 no cleartext was allowed at all, and these
         keep that. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">anthropic.com</domain>
        <domain includeSubdomains="true">openai.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">mistral.ai</domain>
        <domain includeSubdomains="true">x.ai</domain>
        <domain includeSubdomains="true">deepseek.com</domain>
        <domain includeSubdomains="true">groq.com</domain>
        <domain includeSubdomains="true">openrouter.ai</domain>
        <domain includeSubdomains="true">together.ai</domain>
        <domain includeSubdomains="true">together.xyz</domain>
        <domain includeSubdomains="true">ollama.com</domain>
        <domain includeSubdomains="true">huggingface.co</domain>
        <domain includeSubdomains="true">open-meteo.com</domain>
        <domain includeSubdomains="true">openstreetmap.org</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <!-- 0.9 web search: the search services' and lookups' own domains (your SearXNG is decided by LanRule, as a helper). -->
        <domain includeSubdomains="true">search.brave.com</domain>
        <domain includeSubdomains="true">kagi.com</domain>
        <domain includeSubdomains="true">mojeek.com</domain>
        <domain includeSubdomains="true">wikipedia.org</domain>
        <domain includeSubdomains="true">openlibrary.org</domain>
        <!-- 1.0: Termux's weekly update check asks F-Droid's API (and GitHub's, above). -->
        <domain includeSubdomains="true">f-droid.org</domain>
        <!-- 1.0: DuckDuckGo's Instant Answer API (api.duckduckgo.com). A search in your browser is the browser's, not Robot's. -->
        <domain includeSubdomains="true">duckduckgo.com</domain>
    </domain-config>
</network-security-config>
