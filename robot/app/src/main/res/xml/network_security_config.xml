<?xml version="1.0" encoding="utf-8"?>
<!-- 0.6.0, for a helper on your own network: Robot's own rule decides which http:// addresses a helper may use (core
     LanRule: loopback, private, link-local, Tailscale's 100.64/10 and IPv6 unique-local addresses only; enforced again on
     every connection by the helper's DNS filter and network interceptor, :claude HelperHttp). This file only lets
     OkHttp try. Clients for a company refuse cleartext in code too. User-added CAs are never trusted: one could read a
     company's traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Never cleartext to a company or to the model downloads, whatever the code does. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">anthropic.com</domain>
        <domain includeSubdomains="true">openai.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">mistral.ai</domain>
        <domain includeSubdomains="true">x.ai</domain>
        <domain includeSubdomains="true">deepseek.com</domain>
        <domain includeSubdomains="true">groq.com</domain>
        <domain includeSubdomains="true">openrouter.ai</domain>
        <domain includeSubdomains="true">together.ai</domain>
        <domain includeSubdomains="true">together.xyz</domain>
        <domain includeSubdomains="true">ollama.com</domain>
        <domain includeSubdomains="true">huggingface.co</domain>
        <domain includeSubdomains="true">open-meteo.com</domain>
    </domain-config>
</network-security-config>
