<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Robot's own signature permission: only apps signed with Robot's key (keys/README.md) hold it. It guards
         the :brain service and the main app -> voice process commands. 1.0: named after the application ID
         (ai.robot_app.permission.INTERNAL), as are the providers and task affinities, so 1.0 installs beside 0.9. -->
    <permission
        android:name="${applicationId}.permission.INTERNAL"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.INTERNAL" />

    <!-- Six uses only: the model downloads (DownloadManager: huggingface.co, and since 0.5.0 the fast translation
         engine's files from Mozilla's storage.googleapis.com bucket); when you ask, a helper (the :voice process: the company you
         added, api.anthropic.com for Claude, 0.6.0); your own AI server, if you add one (0.6.0, the :voice process,
         only addresses on your own network or https); when you ask for the weather or the nearest place (0.4.0),
         Open-Meteo and a Nominatim server (the :voice process, and the main app once to look up your Home for weather);
         Settings › Updates (the main app, GitHub: api.github.com and its download servers); and, 0.9, when you set up web
         search and ask, the search service you chose (your own SearXNG, Brave, Kagi, Mojeek, a public SearXNG, Wikipedia,
         Open Library) and up to 3 of its result pages (the :voice process). Everything else runs on the phone; the :mt
         process never goes online. The only network permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 0.2.3, "Call audio" playback only (Settings › Voice): the phone in communication mode with the loudspeaker as the
         call device while Robot speaks, as calling apps do for the echo canceller. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 0.2.3: only if the user grants it with adb (a development permission): Robot then keeps
         Settings.Secure voice_recognition_service set to its own recognizer, which is what keeps it the assistant across
         restarts (core AdbFixes.kt). It writes that one key and nothing else. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The assistant check 3 minutes after BOOT_COMPLETED (as in the probe). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Phase 2, runtime permissions asked for only by the main app, when you tap Allow or turn a feature on:
         contacts (texts and emails by name, lookups), the calendar (read events, add new ones). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 0.4.0, also asked for by the main app only, when you tap Allow: the weather "here". Approximate only (never
         ACCESS_FINE_LOCATION); Robot rounds it to two decimals before Open-Meteo sees it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 0.4.0, optional: Usage access, which you turn on yourself in Android's settings (Robot only opens the page).
         phone_status then lists the apps using the most space (StorageStatsManager). Declared so Robot is in that list. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- 0.4.0, optional, asked for by the main app only when you tap Allow: photos and videos, so free_storage can offer
         the largest ones to delete (Android's own confirmation deletes them). "Select photos" (partial access) works too.
         Never All files access (MANAGE_EXTERNAL_STORAGE) or READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- 0.5.0, conversation mode: the transcribing session is a microphone foreground service in the :voice process (its
         notification is the recording indicator), holding a partial wake lock only while it runs. RECORD_AUDIO is
         above. No new network use: transcripts never leave the phone unless you share them. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 0.8, routines: speaks a routine with the screen off. Android 17 lets audio play in the background only from a visible
         activity or a foreground service that isn't short (RoutineSpeakingService, mediaPlayback, alive only while a routine
         speaks). Normal permission, no prompt. Exact alarms are USE_EXACT_ALARM, above. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Settings › Updates: Robot installs its own updates from its GitHub releases, after checking each against the release's
         SHA256SUMS and Robot's signing key. A special app access you turn on yourself (Settings › Apps › Special app access ›
         Install unknown apps › Robot); until then Robot can only download and check. It installs nothing but Robot. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only for "Install updates without asking" (off unless you turn it on): lets Robot ask Android to install its own update
         without the confirmation window (Android 12 and later; Android still asks when another app store keeps Robot's
         updates). A normal permission, granted at install; without it Android ignores the request and always asks. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- 0.8, headset and car mode: each declared but asked for only from its own settings row, never at install or start.
         "Nearby devices" (Settings › Headset › Answer the headset's voice button, or Car mode's row): tells the headset Robot
         listens within the 5 s Android waits, and knows devices by their whole address and class. It doesn't allow scanning. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Settings › Car mode › Calls › "Call directly after a spoken yes": ACTION_CALL after the read-back and yes, never an
         emergency number (always the dialer). Without it, every call opens the dialer and you tap Call. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Settings › Car mode › "Do Not Disturb while driving" (off): Robot switches only its own "Driving (Robot)" rule, once
         you grant Do Not Disturb access in Android's settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- 0.9, the Termux agent (off until you set it up in Settings › Termux): a dangerous permission Termux itself defines,
         asked for by the main app only, from that page. With it (and allow-external-apps=true in Termux) the :voice process
         sends commands to Termux's RunCommandService; each one's card comes first unless you chose otherwise. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <!-- open_app: every app with a launcher icon (no QUERY_ALL_PACKAGES). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="om" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- 0.8: calls (the dialer, or a call after car mode's spoken yes), and who answers the headset button's three
             intents (Assistant setup's "Headset button" row: Robot, or "ask each time"). -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.speech.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Text to speech engines (GrapheneOS Speech Services). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- The setup screen counts the speech recognizers installed. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="app.organicmaps" />
        <!-- Phase 2 hand-offs: Cheogram (texts, xmpp:; and SEND text/plain to its share screen when no contact fits,
             and since 0.4.0 its contact list and StartConversationActivity by class, all covered by its <package>
             entries), Proton Mail (mailto:), the SMS app (smsto:), the calendar app's editor (INSERT). Drafts only: you
             press Send there. -->
        <package android:name="com.cheogram.android" />
        <package android:name="com.cheogram.android.playstore" />
        <package android:name="ch.protonmail.android" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="xmpp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- 0.7, Settings › Messages: the messaging apps whose notifications Robot may read (each a switch, all off), so
             Settings can say which are installed and "Open the chat" can hand your reply to them as a draft. -->
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="im.molly.app" />
        <package android:name="com.android.messaging" />
        <package android:name="com.google.android.apps.messaging" />
        <!-- A helper's app route: the official Claude app, resolved at run time (claude://, https claude.ai, a share), and
             since 1.0.0 the other companies' apps a helper can open with a share of your question (core Presets). -->
        <package android:name="com.anthropic.claude" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="ai.x.grok" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="ai.mistral.chat" />
        <package android:name="com.deepseek.chat" />
        <!-- 0.9, the Termux agent: Termux's signer, version and RunCommandService (RUN_COMMAND doesn't work without it). -->
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="claude" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="claude.ai" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".RobotApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Robot"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">

        <!-- Main process: the app (history, settings, model manager, assistant setup). Never loads an engine. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 0.5.0: a long press on the "Transcribe" Quick Settings tile opens Settings › Conversation. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- 0.5.0: launcher shortcuts "Transcribe" and "Transcripts". -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- 0.5.0: exported transcripts for the share sheet (cacheDir/exports only), from the main app. -->
        <provider
            android:name=".sys.ExportProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/export_paths" />
        </provider>
        <!-- "Robot Notes" on the home screen: the main app, opened on the Notes screen (MainActivity reads the alias). -->
        <activity-alias
            android:name=".ui.NotesLauncher"
            android:targetActivity=".ui.MainActivity"
            android:label="@string/notes_name"
            android:icon="@mipmap/ic_notes"
            android:roundIcon="@mipmap/ic_notes"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ":voice": the assistant, its session (the panel), the listener, speech engines, tools. sherpa-onnx loads only here. -->
        <service
            android:name=".assistant.RobotVoiceService"
            android:process=":voice"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/voice_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".assistant.RobotSessionService"
            android:process=":voice"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />
        <!-- Named by the voice-interaction metadata (android:recognitionService). It MUST stay discoverable
             (exported, RecognitionService intent filter, android.speech meta-data, selectableAsDefault left at
             its default true): at every boot VoiceInteractionManagerService.initForUser keeps a third-party
             assistant only when a current speech recognizer is set and selectable; without one it clears the
             assistant (probe 1.1 failed the reboot test exactly so). It refuses every request in phase 1 and,
             like the system recognizers, takes no permission: it reads nothing and answers only "unavailable". -->
        <service
            android:name=".assistant.RobotRecognitionService"
            android:process=":voice"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data android:name="android.speech" android:resource="@xml/recognition_service" />
        </service>
        <!-- Camera / photo picker trampoline for the panel (a session cannot start activities for a result). -->
        <activity
            android:name=".assistant.CaptureActivity"
            android:process=":voice"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity="${applicationId}.capture"
            android:theme="@style/Theme.Robot.Translucent" />
        <!-- 1.0: Robot's app opens the panel for Run now, a Ready card or Continue through this trampoline, which asks the
             assistant service itself to show it (another app's showAssist arguments are dropped). Not exported. -->
        <activity
            android:name=".assistant.PanelLaunchActivity"
            android:process=":voice"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Robot.Translucent" />
        <!-- A helper's connection window (0.6.0; Claude's key window before): its API key is pasted here, in the :voice
             process, encrypted there and never passes through the main app (which opens this window by class name), and Test
             connection runs here. -->
        <activity
            android:name=".assistant.HelperConnectionActivity"
            android:process=":voice"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Robot.Translucent" />
        <!-- 0.9: Settings › Web search's set-up window: a search service's key is pasted here, in the :voice process, and Test
             runs here (the main app opens it by class name and never reads a key or loads the HTTP client). -->
        <activity
            android:name=".assistant.WebSearchActivity"
            android:process=":voice"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Robot.Translucent" />
        <!-- 0.4.0: Android's own confirmation before a photo or video you picked on a free_storage card is deleted (an
             activity must start it for a result; the panel can't). -->
        <activity
            android:name=".assistant.MediaDeleteActivity"
            android:process=":voice"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.delete"
            android:theme="@style/Theme.Robot.Translucent" />
        <!-- "Pick in Cheogram" (0.4.0): opens Cheogram's contact list for a result (ACTION_CREATE_SHORTCUT, nothing goes on the
             home screen), offers to remember who was picked in People, then opens their chat with the text. Started by the
             panel's card only. -->
        <activity
            android:name=".assistant.CheogramPickActivity"
            android:process=":voice"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.pick"
            android:theme="@style/Theme.Robot.Translucent" />
        <!-- 0.8, headset mode (design §3.6): what a headset's or car's voice button (VOICE_COMMAND, after AT+BVRA) and a wired or
             USB headset's long press or a voice-assist key (the two speech actions) start. Exported, because Android starts
             it; exactly these three actions. Translucent, no history, not in Recents, over the lock screen only to pass the
             press on to the assistant's session: it shows nothing and finishes at once. "Headset button opens Robot" off
             disables it (other apps get the button). -->
        <activity
            android:name=".assistant.headset.HeadsetEntryActivity"
            android:process=":voice"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.headset"
            android:theme="@style/Theme.Robot.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.speech.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 0.8, car mode (design §4.3): the big-button car screen, in :voice where car mode runs. Not exported: only car mode
             and its notification open it. Over the lock screen only during the trusted session (set in code). -->
        <activity
            android:name=".assistant.car.CarModeActivity"
            android:process=":voice"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.car"
            android:theme="@style/Theme.Robot" />
        <!-- 0.5.0, conversation mode (docs/conversation-mode.md 1, 5): the session's microphone foreground service, its
             transcript screen, the Transcription check (Settings › Voice) and the Quick Settings tile, all in :voice where
             the listener and the speech model live. Never started by Robot on its own (START_NOT_STICKY, never at boot). -->
        <service
            android:name=".assistant.conversation.ConversationService"
            android:process=":voice"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <activity
            android:name=".assistant.conversation.ConversationActivity"
            android:process=":voice"
            android:exported="false"
            android:label="@string/shortcut_transcribe"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.transcribe"
            android:excludeFromRecents="false" />
        <activity
            android:name=".assistant.conversation.TranscriptionCheckActivity"
            android:process=":voice"
            android:exported="false"
            android:taskAffinity="${applicationId}.check"
            android:windowSoftInputMode="adjustResize" />
        <!-- 0.5.0, phase 5.6: a transcript's summary, Robot's own or a stronger AI's after the consent card (in :voice: Robot's
             model and the helpers' keys are reached from there only; the main app opens it by name). -->
        <activity
            android:name=".assistant.conversation.SummaryActivity"
            android:process=":voice"
            android:exported="false"
            android:taskAffinity="${applicationId}.summary" />
        <!-- 0.5.0, phase 5.3: "Your voice", the optional "me" voiceprint (encrypted in :voice; the main app opens it by name). -->
        <activity
            android:name=".assistant.conversation.VoiceprintActivity"
            android:process=":voice"
            android:exported="false"
            android:taskAffinity="${applicationId}.voiceprint" />
        <service
            android:name=".assistant.conversation.ConversationTileService"
            android:process=":voice"
            android:exported="true"
            android:icon="@drawable/ic_robot"
            android:label="@string/tile_transcribe"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <!-- 0.8, routines (docs/plans/routines-headset-car-design.md 2): in :voice, where the voice is. The receiver gets the one
             exact alarm for the next time routine (Robot's own PendingIntent), a Ready notification's tap, and the system's
             BOOT_COMPLETED, TIME_SET, TIMEZONE_CHANGED and MY_PACKAGE_REPLACED to set that alarm again; not exported, so no
             other app can send it anything. GrapheneOS Clock's ALARM_ALERT and ALARM_DONE are heard by a runtime receiver
             (RoutineHub) only while a routine waits for them. The service speaks a routine nobody opened Robot for, with
             its notification (Next, Repeat, Stop); never sticky, never at boot. -->
        <receiver
            android:name=".assistant.routines.RoutineAlarmReceiver"
            android:process=":voice"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".assistant.routines.RoutineSpeakingService"
            android:process=":voice"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- 0.9: Termux's result for a command Robot sent, through Robot's own one-shot PendingIntent (explicit to this
             receiver). Not exported: no other app can send it anything. -->
        <receiver
            android:name=".assistant.TermuxResultReceiver"
            android:process=":voice"
            android:exported="false" />
        <!-- The camera app writes the photo here (app cache, deleted right after it is read). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.capture"
            android:process=":voice"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/capture_paths" />
        </provider>

        <!-- "Learn names from Cheogram notifications" (0.4.0): off until you turn it on in Settings › People and allow
             notification access. Reads only Cheogram's 1:1 chats: the sender's name, address and your account, never
             message text. 0.7: the same listener reads your messages when Settings › Messages is on, for the apps you
             turned on there only, into RAM only (people.MessageTap). Main process: no model, no voice process; it unbinds
             itself while both are off. Only the system can bind it (BIND_NOTIFICATION_LISTENER_SERVICE). It asks for
             conversations only; 0.7 no longer greys out Silent in Android's page for it, so you may allow quiet messages
             (Cheogram's quiet hours) there yourself. Never ongoing notifications. -->
        <service
            android:name=".people.CheogramListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data android:name="android.service.notification.default_filter_types" android:value="conversations" />
            <meta-data android:name="android.service.notification.disabled_filter_types" android:value="ongoing" />
        </service>
        <!-- 0.7: how the panel (the :voice process) asks for your messages and sends a reply: main process, where the listener,
             the RAM buffer and the notifications' PendingIntents are. Not exported, Robot's signature permission, and it
             answers Robot's own uid only. -->
        <service
            android:name=".people.MessagesBridge"
            android:exported="false"
            android:permission="${applicationId}.permission.INTERNAL" />

        <!-- Not exported: the system's boot broadcast still arrives, other apps cannot fake it. Direct-boot aware (0.2.3)
             so it also gets LOCKED_BOOT_COMPLETED, before the first unlock: there it only checks the speech recognizer
             setting (no files of the credential-encrypted storage; RobotApp only logs). -->
        <receiver android:name=".boot.BootReceiver" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- 3 minutes after BOOT_COMPLETED (an alarm set by BootReceiver, or UpdatedReceiver): is the assistant running? -->
        <receiver android:name=".boot.BootCheckReceiver" android:exported="false" />
        <!-- Robot was updated, which ended its processes: what BootReceiver does after a restart, then the updater's part
             (its downloads go, "Robot updated to ..." once). Not exported: Android sends MY_PACKAGE_REPLACED to Robot alone. -->
        <receiver android:name=".boot.UpdatedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Settings › Updates, all in the main process. The daily check and the download on Wi-Fi (JobScheduler): only the
             system binds the service (BIND_JOB_SERVICE), so it needn't be exported. The install session's result comes back
             through Robot's own PendingIntent to a receiver nothing else can reach. -->
        <service
            android:name=".update.UpdateJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <receiver android:name=".update.InstallStatusReceiver" android:exported="false" />
    </application>
</manifest>
