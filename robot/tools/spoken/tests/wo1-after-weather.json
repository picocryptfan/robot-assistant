    {"do": "wait_reply", "seconds": 120},
    {"do": "check", "what": "tool", "equals": "weather"},
    {"do": "end"},
    {"do": "open", "how": "button"},
    {"do": "say", "text": "Did you go online?", "voice": "heart"},
    {"do": "wait_reply", "seconds": 30, "contains": "weather"},
    {"do": "check", "what": "router", "equals": "OnlineRouter"},
    {"do": "end"}
  ]
}
