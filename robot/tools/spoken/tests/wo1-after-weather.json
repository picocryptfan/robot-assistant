{
  "format": 1,
  "id": "wo1-after-weather",
  "title": "The weather, then what went online says so",
  "safety": "read",
  "testBench": ["WO1"],
  "needs": {"model": true},
  "setup": [{"set": "speakReplies", "value": "VOICE"}],
  "steps": [
