{
  "format": 1,
  "id": "stop-story",
  "title": "Stop while Robot tells a story, and the next question is answered at once",
  "safety": "read",
  "testBench": ["v23-say-stop", "v46-stop-long"],
  "needs": {"model": true},
  "setup": [{"set": "speakReplies", "value": "VOICE"}],
  "steps": [
    {"do": "open", "how": "wake"},
    {"do": "say", "text": "Tell me a long story about a dragon.", "voice": "heart"},
    {"do": "pause", "seconds": 15},
    {"do": "say", "text": "Stop.", "voice": "heart"},
    {"do": "pause", "seconds": 3},
    {"do": "check", "what": "log", "regex": "stop_word acted=true"},
    {"do": "open", "how": "wake"},
    {"do": "wait_listening", "seconds": 30},
    {"do": "say", "text": "What's two plus two?", "voice": "heart"},
    {"do": "wait_reply", "seconds": 90, "regex": "(?i)four|4"},
    {"do": "check", "what": "reply", "contains": "still on", "absent": true},
    {"do": "end"}
  ]
}
