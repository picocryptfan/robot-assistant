{
  "format": 1,
  "id": "helper-near-misses",
  "title": "Words close to \"ask the helper\" stay with Robot",
  "safety": "read",
  "testBench": ["v100-helper-near-misses"],
  "needs": {"model": true},
  "setup": [{"set": "speakReplies", "value": "VOICE"}],
