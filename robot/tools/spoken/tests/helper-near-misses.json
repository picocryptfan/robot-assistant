    {"do": "wait_reply", "seconds": 120},
    {"do": "check", "what": "router", "equals": "HelperRouter", "absent": true},
    {"do": "end"},
    {"do": "open", "how": "button"},
    {"do": "say", "text": "Ask for help.", "voice": "heart"},
    {"do": "wait_reply", "seconds": 120},
    {"do": "check", "what": "router", "equals": "HelperRouter", "absent": true},
    {"do": "end"}
  ]
}
