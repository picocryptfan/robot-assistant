    {"do": "check", "what": "router", "equals": "RoutineRouter"},
    {"do": "open", "how": "wake"},
    {"do": "wait_listening", "seconds": 30},
    {"do": "say", "text": "Rappelle-moi demain matin d'apporter le passeport.", "voice": "siwis"},
    {"do": "wait_reply", "seconds": 30},
    {"do": "check", "what": "router", "equals": "RoutineRouter"},
    {"do": "end"}
  ]
}
