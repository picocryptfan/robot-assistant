{
  "format": 1,
  "id": "brief-reminder",
  "title": "A reminder for the brief, in English and French",
  "safety": "robot-data",
  "testBench": ["v80-br-reminders"],
  "setup": [{"set": "speakReplies", "value": "VOICE"}],
  "steps": [
