{
  "protocol": 1,
  "package": "ai.robot_app.spoken",
  "receiver": "app.heyrobot.spoken.SpokenReceiver",
  "activity": "app.heyrobot.ui.MainActivity",
  "results": "files/spoken/results.jsonl",
  "clipsDir": "files/spoken/clips",
  "importDir": "files/spoken/import",
  "recordingsDir": "files/spoken/recordings",
  "clip": {"encoding": "s16le", "rate": 16000, "channels": 1, "suffix": ".s16"},
  "minCleanAccuracy": 0.8,
  "voices": {
    "heart": {"lang": "en", "engine": "kokoro", "sid": 3},
    "kitten": {"lang": "en", "engine": "kitten", "sid": 7},
    "siwis": {"lang": "fr", "engine": "kokoro", "sid": 30}
  },
  "speeds": [0.85, 1.0, 1.2],
  "noises": {"none": [], "pink": [20, 10, 5], "fan": [20, 10, 5], "babble": [20, 10, 5]},
  "safetyClasses": ["read", "robot-data", "stops-at-card"],
  "harmlessCards": ["flashlight", "lookup_contact",
    "add_note", "add_to_list", "find_notes", "read_calendar", "weather", "phone_status", "remember", "find_files", "read_file", "calculate"],
  "riskyCards": ["set_timer", "set_alarm", "open_app", "maps_search", "maps_navigate", "free_memory", "send_text", "draft_email", "call", "add_event", "free_storage", "web_search", "browser_search", "ask_claude",
    "forget", "termux_script", "termux_command", "connection", "hand_off", "ask_robot", "other"],
  "declines": {"en": ["no", "no thanks", "no thank you", "cancel", "stop", "never mind"],
    "fr": ["non", "non merci", "annule", "arrete", "laisse faire"]},
  "yesWords": {"en": ["yes", "yeah", "yep", "sure", "ok", "okay", "confirm", "go ahead", "do it", "send it", "call them"],
    "fr": ["oui", "ouais", "ok", "d accord", "confirme", "vas y", "envoie le", "appelle le"]},
  "riskyWords": {"en": ["send", "text", "message", "call", "phone", "email", "delete", "remove", "erase", "forget", "pay", "buy"],
    "fr": ["envoie", "envoyer", "texto", "message", "appelle", "appeler", "telephone", "courriel", "supprime", "supprimer",
      "efface", "effacer", "oublie", "paie", "payer", "achete", "acheter"]},
  "neverGranted": ["android.permission.CALL_PHONE", "android.permission.READ_CONTACTS", "com.termux.permission.RUN_COMMAND",
    "android.permission.READ_CALENDAR"],
  "otherAppWords": {"en": ["timer", "timers", "countdown", "alarm", "alarms", "wake me", "flashlight", "torch", "911", "open", "launch", "search", "directions",
      "navigate", "near me", "nearest", "take me", "play music", "next song", "skip this song", "previous song", "go back a song", "pause the music", "stop the music",
      "resume the music", "unpause", "voicemail"],
    "fr": ["minuteur", "minuterie", "chrono", "alarme", "reveil", "reveille", "lampe de poche", "lampe", "911", "ouvre", "ouvrir", "lance", "cherche", "recherche",
      "itineraire", "emmene", "mets de la musique", "chanson suivante", "chanson precedente", "prochaine toune", "passe la toune", "coupe la musique", "arrete la musique",
      "reprends la musique", "remets la musique", "messagerie vocale"]},
  "otherAppStarts": {"en": ["play", "google", "resume"], "fr": ["joue", "reprends"]},
  "settings": {"speakReplies": ["VOICE", "ALWAYS", "NEVER"], "voiceCards": "boolean", "wakeWord": "boolean", "livePartials": "boolean",
    "directAnswers": "boolean", "saveHistory": "boolean", "speechRate": "number", "voice": "string"},
  "routers": ["BrowserRouter", "ConversationRouter", "FeedbackRouter", "FilesRouter", "HandsFreeRouter", "HelperRouter", "LaterRouter", "LinkRouter", "ListsRouter", "CorrectRouter",
    "LockRouter", "LogbookRouter", "MessagesRouter", "MusicRouter", "OnlineRouter", "PageSummaryRouter", "PlanRouter", "PreRouter", "ReadRouter", "RoutineRouter", "SkillRouter", "StepRouter", "SumsRouter", "LastTimeRouter",
    "TermuxRouter", "ToolRouter", "WebRouter", "model"],
  "routersOff": ["MusicRouter"],
  "routersNoTurn": ["PreRouter", "ToolRouter"]
}
