# Build output
build/
.gradle/
.kotlin/
*.apk
*.aab
local.properties

# Signing keys never go in git
*.keystore
*.jks
keystore-backup/

# Robot Probe: third-party binaries and models come from tools/fetch_third_party.sh
probe/app/src/main/jniLibs/
probe/app/src/main/assets/kws/*.onnx
probe/app/src/main/assets/vad/*.onnx

# Robot (robot/): third-party binaries and models come from robot/tools/fetch_third_party.sh
robot/voice/src/main/jniLibs/
robot/voice/src/main/assets/kws/*.onnx
robot/voice/src/main/assets/kws/bpe.model
robot/voice/src/main/assets/vad/*.onnx
robot/voice/src/main/assets/espeak-ng-data/
robot/**/*.so
robot/**/*.onnx
robot/**/*.litertlm

# Editors
.idea/
*.iml
.DS_Store
*.p12
*.pass

# Robot 0.5.0 fast translation engine: tools/build_robotmt.sh's fetched sources and build trees, and the library it
# builds (packaged by Gradle when present, never stored in git).
robot/mt/native/
robot/mt/src/main/jniLibs/
